# Talvext environment variables.
# Copy to .env.local and fill in real values. Never commit .env.local.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser, so it must never
# hold a secret.

# --- Clerk (auth + organizations) -------------------------------------------
# Both are printed by `clerk env pull`, or found in the Clerk dashboard.
# Safe for the browser: identifies your Clerk instance, grants nothing.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Server only. Full admin access to your Clerk instance.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Route paths, not secrets. Without these, a signed out user hitting a
# protected route is sent to Clerk's hosted account portal instead of the
# sign in page in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Server only. Verifies webhook deliveries on /api/webhooks/clerk; the
# signature is that route's only authentication. From the Clerk dashboard
# webhook endpoint (production) or `clerk webhooks` (local development).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase (database) -----------------------------------------------------
# Your project's API endpoint.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Safe for the browser: every request it makes is still filtered by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Server only. BYPASSES ROW LEVEL SECURITY entirely. Use only where there is
# genuinely no tenant context (webhooks, cron, migrations). Never import this
# into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron (monitor checks) ---------------------------------------------------
# Server only. The external scheduler (cron-job.org) sends it as a bearer
# token on every invocation of /api/cron/check-monitors, and the route
# rejects any request without it. Set the same value in the Vercel project
# and in the scheduler's request header. Generate a long random value, for
# example: openssl rand -hex 32
CRON_SECRET=

# --- Notifications (Resend email, BRD F10) -----------------------------------
# Server only. The Resend API key alert emails send with. When unset, email
# alerts are skipped (logged once); Discord webhooks are unaffected.
RESEND_API_KEY=
# The From address for alert emails, verified in Resend. When unset, email
# alerts are skipped (logged once). Example: Talvext Alerts <alerts@yourdomain.com>
RESEND_FROM=

# --- BYOK key encryption (AI support chat) -----------------------------------
# Server only. The application level key that encrypts each org's AI provider
# key (AES 256 GCM) before it reaches the database. It is NEVER stored in the
# database and NEVER committed. Must be exactly 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
# Set it in .env.local for development and in Vercel for deployment.
API_KEY_ENCRYPTION_SECRET=

# --- Stripe (billing, BRD F13) ------------------------------------------------
# TEST MODE ONLY until the live gates in docs/DECISIONS.md (2026-08-07) are
# passed by a human: clickwrap shipped, statement descriptor set to TALVEXT,
# and an explicit go ahead. Every key below comes from the Stripe dashboard
# in test mode; a restricted key (rk_test_...) is preferred over the full
# secret key.
# Server only. The API key every server side Stripe call uses.
STRIPE_SECRET_KEY=
# Server only. Verifies webhook deliveries on /api/webhooks/stripe; the
# signature is that route's only authentication. From the webhook endpoint in
# the Stripe dashboard, or `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=
# Safe for the browser: identifies the Stripe account to Stripe.js, grants
# nothing. Reserved for Stripe Checkout in F13 PR 2.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server only. The platform key that serves MANAGED AI answers for plans
# that include them (F13 PR 3), provider agnostic since the follow up: name
# the provider in PLATFORM_AI_PROVIDER (anthropic or openai) and put the key
# in the MATCHING variable below. Exactly one configured pair is valid; the
# provider unset, unrecognized, or pointing at an empty key var all mean the
# managed path is off, and entitled orgs see the assistant as unavailable
# (logged as chat.platform_key.not_configured) while BYOK chat is unaffected
# either way. Never an org's BYOK key and never reachable from the browser.
# Guard rails per provider are in RUNBOOK section 8: a dedicated Anthropic
# workspace with a spend limit, or a dedicated OpenAI project with a monthly
# budget limit.
PLATFORM_AI_PROVIDER=
PLATFORM_ANTHROPIC_API_KEY=
PLATFORM_OPENAI_API_KEY=

# --- Operator error sink (platform observability) -----------------------------
# Server only, and NOT the same thing as an org's Discord webhook in
# notification settings: this channel belongs to whoever runs Talvext, and it
# receives Talvext's own failures, never a customer's incidents. When unset,
# platform errors are logged and not posted (said once), which is the intended
# behaviour for local development. Create a channel webhook in your own Discord
# server and paste the full URL.
OPS_DISCORD_WEBHOOK=

# --- Azure live verification (developer only, never deployed) ------------------
# Read ONLY by tests/azure-live-verification.test.ts, which proves the cost
# pull against a real subscription and skips itself entirely when these are
# absent (CI holds no cloud credential on purpose). The app itself never reads
# these: real connections store their secret AES encrypted in the database.
# Values come from the service principal minted by the connect wizard's
# command (Cost Management Reader on one subscription, nothing wider).
TEST_AZURE_SUBSCRIPTION_ID=
TEST_AZURE_TENANT_ID=
TEST_AZURE_CLIENT_ID=
TEST_AZURE_CLIENT_SECRET=
